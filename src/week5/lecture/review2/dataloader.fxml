<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="CENTER"
      prefHeight="200.0" prefWidth="400.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="week5.lecture.review2.Controller">
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
            <Label prefWidth="75.0" text="Data:" />
            <TextField fx:id="dataEntry" prefHeight="50.0" prefWidth="300.0" />
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
            <Label prefHeight="17.0" prefWidth="75.0" text="Filename:" />
            <TextField fx:id="filenameEntry" prefHeight="50.0" prefWidth="300.0" />
      </HBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
            <Button onAction="#saveAction" prefHeight="50.0" prefWidth="200.0" text="Save" />
            <Button onAction="#loadAction" prefHeight="50.0" prefWidth="200.0" text="Load" />
      </HBox>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
